# Copy to deploy/.env and replace every value. Never commit the real file.
XCHONNECT_DB_PASSWORD=change-me-long-random
# 32 random bytes, base64url (shared by all relay nodes): openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
XCHONNECT_POW_KEY=
XCHONNECT_CREATION=pow,ticket,api_key
# customer:key pairs (keys >= 16 chars), comma separated
XCHONNECT_API_KEYS=
XCHONNECT_GATEWAY_POLICY=allowlist
XCHONNECT_GATEWAY_ALLOWLIST=https://push.example-wallet.app/
# OHTTP gateway keys, id:seed pairs newest first (seed: 32 random bytes, base64url as above).
# Example: XCHONNECT_OHTTP_KEYS=1:<key from the command above>
# Same value on all nodes. Required while XCHONNECT_OHTTP=true (the default): the relay
# does not serve without it. XCHONNECT_OHTTP=false runs without a gateway.
XCHONNECT_OHTTP_KEYS=
# Long-poll limit through OHTTP: at most your OHTTP relay's request timeout minus 5 s.
XCHONNECT_MAX_WAIT_OHTTP_S=0
# Gateway (profile "gateway"): base64url X25519 secret keys, newest first
XCHONNECT_GATEWAY_KEYS=
# Wallet vendors only. Credential files live in this directory, mounted read-only at
# /secrets; never put key material in these variables. See docs/operating.md.
XCHONNECT_GATEWAY_SECRETS_DIR=./secrets
XCHONNECT_GATEWAY_APNS_TEAM_ID=
XCHONNECT_GATEWAY_APNS_KEY_ID=
XCHONNECT_GATEWAY_APNS_KEY_FILE=/secrets/apns.p8
XCHONNECT_GATEWAY_APNS_TOPIC=
# production | sandbox | both
XCHONNECT_GATEWAY_APNS_ENV=production
XCHONNECT_GATEWAY_FCM_SERVICE_ACCOUNT_FILE=/secrets/fcm-service-account.json
