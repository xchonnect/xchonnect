# Copy to deploy/.env and replace every value. Never commit the real file.
XCHONNECT_DB_PASSWORD=change-me-long-random
# 32 random bytes, base64url (shared by all relay nodes): openssl rand 32 | basenc --base64url | tr -d =
XCHONNECT_POW_KEY=
XCHONNECT_CREATION=pow,ticket,api_key
# customer:key pairs (keys >= 16 chars), comma separated
XCHONNECT_API_KEYS=
XCHONNECT_GATEWAY_POLICY=allowlist
XCHONNECT_GATEWAY_ALLOWLIST=https://push.example-wallet.app/
# Gateway (profile "gateway"): base64url X25519 secret keys, newest first
XCHONNECT_GATEWAY_KEYS=
