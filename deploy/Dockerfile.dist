# syntax=docker/dockerfile:1
#
# Release images for the relay and the push gateway.
#
# Unlike deploy/Dockerfile (which compiles, for local use), this packages the binaries
# that scripts/release-build.sh already produced and that the release signed: the image
# therefore contains byte-for-byte the artifact whose digest appears in SHA256SUMS.
#
# The build context holds one directory per Docker architecture, so a single
# multi-platform build picks the right binary through BuildKit's TARGETARCH:
#
#   ctx/amd64/xchonnect-relay      from x86_64-unknown-linux-gnu
#   ctx/arm64/xchonnect-relay      from aarch64-unknown-linux-gnu
#
#   SOURCE_DATE_EPOCH=$(git -c log.showsignature=false log -1 --pretty=%ct) \
#   docker buildx build -f deploy/Dockerfile.dist --target relay \
#     --platform linux/amd64,linux/arm64 \
#     --output type=image,name=ghcr.io/xchonnect/xchonnect-relay:1.0.0,push=true,rewrite-timestamp=true \
#     ctx
#
# Reproducibility: the base is pinned by digest, the context holds only the binaries, and
# BuildKit's `rewrite-timestamp=true` with SOURCE_DATE_EPOCH clamps every layer and
# config timestamp. Two builds of the same commit must give the same image digest; the
# release workflow builds each image twice and fails if they differ.
#
# The images hold no setting but their port: plain HTTP on 80, the port a host such as
# ONCE expects. The non-root user may bind it where the runtime allows low ports to
# containers (Docker 20.10 and later, bridge networking); elsewhere set the listen
# address to a high port. Everything else comes from the environment at run time: started
# with none of it, the relay and the gateway wait for their settings (docs/operating.md,
# "Waiting for settings").

# gcr.io/distroless/cc-debian12:nonroot - glibc + CA certificates, no shell,
# non-root (uid 65532). Update with:
#   docker buildx imagetools inspect gcr.io/distroless/cc-debian12:nonroot
FROM gcr.io/distroless/cc-debian12@sha256:9dac0a79194e45a7da0158a9c6da57b217585af0786db3845d1f0ec1a0dd182f AS base

FROM base AS relay
ARG TARGETARCH
COPY --chmod=755 ${TARGETARCH}/xchonnect-relay /usr/local/bin/xchonnect-relay
ENV XCHONNECT_LISTEN=0.0.0.0:80
EXPOSE 80
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/xchonnect-relay"]

FROM base AS gateway
ARG TARGETARCH
COPY --chmod=755 ${TARGETARCH}/xchonnect-gateway /usr/local/bin/xchonnect-gateway
ENV XCHONNECT_GATEWAY_LISTEN=0.0.0.0:80
EXPOSE 80
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/xchonnect-gateway"]
